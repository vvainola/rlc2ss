inline constexpr int MAX_ZERO_CROSS_EVENTS = 100;

namespace {

std::unique_ptr<[[ class_name ]]::StateSpaceMatrices> calcStateSpace(Eigen::MatrixXd const& K1,
[[ calc_state_space_parameter_indent ]]Eigen::MatrixXd const& A1,
[[ calc_state_space_parameter_indent ]]Eigen::MatrixXd const& B1,
[[ calc_state_space_parameter_indent ]]Eigen::MatrixXd const& K2,
[[ calc_state_space_parameter_indent ]]Eigen::MatrixXd const& C1,
[[ calc_state_space_parameter_indent ]]Eigen::MatrixXd const& D1) {
    auto ss = std::make_unique<[[ class_name ]]::StateSpaceMatrices>();
    auto lu = K1.partialPivLu();
    Eigen::MatrixXd A = lu.solve(A1);
    Eigen::MatrixXd B = lu.solve(B1);
    ss->A = A;
    ss->B = B;
    ss->C = (C1 + K2 * A);
    ss->D = (D1 + K2 * B);
    return ss;
}

[[ class_name ]]::StateSpaceMatrices const& calcStateSpaceMatrices([[ class_name ]]::Components const& components,
[[ calc_state_space_matrices_parameter_indent ]]uint64_t switch_combination) {
    static std::mutex            cache_mutex;
    std::scoped_lock<std::mutex> lock(cache_mutex);

    using StateSpaceMap = std::unordered_map<uint64_t, std::unique_ptr<[[ class_name ]]::StateSpaceMatrices>>;
    static std::unordered_map<uint64_t, StateSpaceMap> state_space_cache;
    uint64_t component_hash = components.hash();
    if (state_space_cache.contains(switch_combination)) {
        std::unordered_map<uint64_t, std::unique_ptr<[[ class_name ]]::StateSpaceMatrices>>& cache = state_space_cache.at(switch_combination);
        auto it = cache.find(component_hash);
        if (it != cache.end()) {
            return *it->second;
        }
    }
[[ update_state_space_matrices_body ]]
}

